PORT=3001
# Leave unset for same-origin production. Comma-separated exact origins for split hosting.
# CLIENT_ORIGIN=https://your-domain.example
# TURN relay for restrictive mobile networks; obtain credentials from your TURN provider.
# TURN_URL=turn:your-turn-domain.example:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=
# Optional LiveKit SFU: required when more than six human players are present.
# LIVEKIT_URL=wss://your-livekit-domain.example
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
